# Logs
logs
*.log
.env*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.tsbuildinfo
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env

# Local package/authentication credentials must never enter a release commit.
.npmrc
.netrc
.pypirc

# Storage files (do not track images)
public/shoots/**
!public/shoots/**/.gitkeep

# Playwright e2e artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Playwright MCP/CLI snapshot artifacts
.playwright-cli/
.playwright-mcp/

# Local QA output: browser screenshots and verification logs. These are
# evidence for a review, never part of a release.
/output/
# Certificate and key material must never be committed.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks

# Vite config timestamp junk (local Vite cache dumps)
vite.config.ts.timestamp-*.mjs

