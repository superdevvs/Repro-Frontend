* text=auto eol=lf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary

# Environment files and local operational artifacts never belong in releases.
.env export-ignore
.env.* export-ignore
.env.example -export-ignore
*.pem export-ignore
*.key export-ignore
*.p12 export-ignore
*.pfx export-ignore
*.jks export-ignore
/output export-ignore
/quarantine* export-ignore
